# ── MongoDB ───────────────────────────────────────────────────────────────────
# Connection URI.  Must point at a replica-set member (required for change streams).
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0

# Database and collection to watch.
MONGO_DB=mydb
MONGO_COLLECTION=mycollection

# ── Elasticsearch ─────────────────────────────────────────────────────────────
# Comma-separated list of ES node addresses.
ES_ADDRESSES=http://localhost:9200

# Optional basic-auth credentials.
ES_USERNAME=
ES_PASSWORD=

# Target index name (defaults to MONGO_COLLECTION when unset).
ES_INDEX=

# ── Resume-token storage ──────────────────────────────────────────────────────
# "file"  – persist the token in a local JSON file (TOKEN_FILE).
# "mongo" – persist the token in a metadata collection inside MongoDB.
TOKEN_STORE=file
TOKEN_FILE=resume_token.json

# Name of the metadata collection used when TOKEN_STORE=mongo.
TOKEN_MONGO_META_COLLECTION=_replicator_meta

# How many events to process between resume-token saves.
# Set to 1 for maximum durability; higher values reduce I/O at the cost of
# potentially replaying more events after a crash.
TOKEN_SAVE_INTERVAL=1

# ── Full-sync / resiliency ────────────────────────────────────────────────────
# STARTUP_FULL_SYNC=true  – perform a full MongoDB→ES collection scan on every
# startup before opening the change stream.  All ES operations are idempotent
# so this is always safe; it is the recommended setting when you cannot
# guarantee the service downtime is shorter than the MongoDB oplog window.
# Default: false
STARTUP_FULL_SYNC=false

# STALE_TOKEN_RESYNC=true  – when the saved resume token is no longer in the
# oplog (service was down longer than oplog retention), automatically trigger
# a full sync and reopen the change stream.
# Set to false if you prefer the service to stop and alert instead of
# self-healing (useful when you need manual confirmation before resyncing a
# large collection).
# Default: true
STALE_TOKEN_RESYNC=true

# Number of documents per Elasticsearch bulk request during a full sync.
# Increase for faster syncs on powerful clusters; decrease if you hit
# circuit-breaker / heap-pressure errors.
SYNC_BATCH_SIZE=500

MAX_RETRIES=10
INITIAL_BACKOFF=500ms
MAX_BACKOFF=30s

# ── Logging ───────────────────────────────────────────────────────────────────
# One of: debug | info | warn | error
LOG_LEVEL=info
